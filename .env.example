APP_NAME=Financial Research Copilot
ENVIRONMENT=development
LOG_LEVEL=INFO

# Used only by docker compose to create the Postgres container
POSTGRES_USER=fincopilot
POSTGRES_PASSWORD=fincopilot_dev_password
POSTGRES_DB=fincopilot

# Used by the app. Hostnames "db" and "redis" are the docker compose service names
DATABASE_URL=postgresql+psycopg://fincopilot:fincopilot_dev_password@db:5432/fincopilot
REDIS_URL=redis://redis:6379/0

# Secret used to sign login tokens. Generate one with: openssl rand -hex 32
# Never commit a real value. Anyone who knows it can forge tokens for any user
JWT_SECRET_KEY=replace-me-with-the-output-of-openssl-rand-hex-32
# Optional, these are the defaults
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Used only by pytest (tests/conftest.py). It replaces DATABASE_URL during tests, and the
# database name must end with "_test". Not part of the app settings
TEST_DATABASE_URL=postgresql+psycopg://fincopilot:fincopilot_dev_password@db:5432/fincopilot_test
