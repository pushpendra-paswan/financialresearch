APP_NAME=Financial Research Copilot
ENVIRONMENT=development
LOG_LEVEL=INFO

# Used only by docker compose to create the Postgres container
POSTGRES_USER=fincopilot
POSTGRES_PASSWORD=fincopilot_dev_password
POSTGRES_DB=fincopilot

# Used by the app. Hostnames "db" and "redis" are the docker compose service names
DATABASE_URL=postgresql+psycopg://fincopilot:fincopilot_dev_password@db:5432/fincopilot
REDIS_URL=redis://redis:6379/0

# Secret used to sign login tokens. Generate one with: openssl rand -hex 32
# Never commit a real value. Anyone who knows it can forge tokens for any user
JWT_SECRET_KEY=replace-me-with-the-output-of-openssl-rand-hex-32
# Optional, these are the defaults
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate limits (requests per 60 seconds) and how long cached company and price reads live.
# Optional, these are the defaults
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=120
CACHE_TTL_SECONDS=600

# Sent as the User-Agent on every request to the SEC. The SEC requires it to identify you with a
# real contact email, in the form "FinCopilot your.name@example.com". Replace the example below
SEC_USER_AGENT=FinCopilot your.name@example.com
# Raw downloaded files are saved here before parsing. Optional, this is the default
RAW_DATA_DIR=data/raw
# Filing ingestion stores only filings filed within this many years. Optional, this is the default
FILINGS_LOOKBACK_YEARS=3
FINANCIALS_LOOKBACK_YEARS=6
# Which price provider to use (only "yfinance" for now) and how many years of daily prices every
# run re-syncs. Optional, these are the defaults
PRICE_PROVIDER=yfinance
PRICES_LOOKBACK_YEARS=5
# RAG and the agent work only on these tickers (comma-separated) and on filings filed within this
# many years. Optional, these are the defaults
RAG_TICKERS=AAPL,NVDA
RAG_LOOKBACK_YEARS=2

# Used only by pytest (tests/conftest.py). It replaces DATABASE_URL during tests, and the
# database name must end with "_test". Not part of the app settings
TEST_DATABASE_URL=postgresql+psycopg://fincopilot:fincopilot_dev_password@db:5432/fincopilot_test
# Used only by pytest. Must be a NON-ZERO Redis database number (0 is the development one);
# the tests flush this database before every test
TEST_REDIS_URL=redis://redis:6379/1
